# Database connection
DATABASE_URL="postgresql://user:password@localhost:5432/lcae_practice_exam"

# Auth.js / NextAuth configuration
AUTH_SECRET="your-secret-here-generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Google OAuth credentials
# Get these from https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: <AUTH_URL>/api/auth/callback/google
AUTH_GOOGLE_ID="your-google-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# Optional: Test user for development (enables test credentials provider)
# TEST_USER_EMAIL="test@example.com"
# NEXT_PUBLIC_TEST_USER_EMAIL="test@example.com"
